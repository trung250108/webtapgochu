async function tryLoadExternalVocab() {
  try {
    const resp = await fetch('tu-vung-2026-08-11-500.json', {cache: "no-store"});
    if (!resp.ok) return;
    const external = await resp.json();
    if (!Array.isArray(external) || external.length === 0) return;
    
    const normalized = external.map(item => {
      if(!item || typeof item.word !== 'string' || !item.word.trim()) return null;
      const meanings = Array.isArray(item.meanings) ? item.meanings.filter(m=>m).map(m=>m.trim()) :
                       (typeof item.meaning === 'string' ? item.meaning.split(';').map(s=>s.trim()).filter(Boolean) : []);
      
      // Khởi tạo topic, nếu không có thì dùng AI đoán
      let itemTopic = (typeof item.topic === 'string' && item.topic.trim()) ? item.topic.trim() : "";
      if(!itemTopic || itemTopic === 'Chung') {
          itemTopic = guessTopic(item.word, meanings.join(" "));
      }

      return {
        word: item.word.trim(),
        meanings,
        level: 0,
        example: (typeof item.example === 'string') ? item.example : (EXAMPLE_SENTENCES[item.word] || ''),
        topic: itemTopic
      };
    }).filter(Boolean);
    
    const existing = new Set(vocab.map(v=>v.word.toLowerCase()));
    let added = 0;
    normalized.forEach(n => {
      if(!existing.has(n.word.toLowerCase())){
        vocab.push(n);
        existing.add(n.word.toLowerCase());
        added++;
      } else {
        const ex = vocab.find(v=>v.word.toLowerCase()===n.word.toLowerCase());
        n.meanings.forEach(m => { if(!ex.meanings.some(em=>em.toLowerCase()===m.toLowerCase())) ex.meanings.push(m); });
        if(!ex.example && n.example) ex.example = n.example;
        if((ex.topic === 'Chung' || !ex.topic) && n.topic !== 'Chung') ex.topic = n.topic;
      }
    });
    if(added > 0) { sortVocab(); saveVocab(); }
  } catch(err) { console.warn('Error loading external vocab:', err); }
}

