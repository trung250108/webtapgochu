function getModeCandidates(){
  return vocab.map((v,i)=>({v,i})).filter(o => {
    if(currentPracticeTopic !== 'all' && o.v.topic !== currentPracticeTopic) return false;
    if(practiceMode === 'review' && o.v.level < 1) return false;
    if(practiceMode === 'new' && o.v.level !== 0) return false;
    return true;
  }).map(o=>o.i);
}

function buildPracticeOrder(){
  const candidates = getModeCandidates();
  const indices = [];
  candidates.forEach(i=>{
    const v = vocab[i];
    if(practiceMode==='all' && v.level >= 1){
      if(Math.random() < LEVEL_INCLUDE_CHANCE[v.level]) indices.push(i);
    } else { indices.push(i); }
  });
  if(indices.length === 0 && practiceMode==='all'){ candidates.forEach(i=>indices.push(i)); }
  for(let i=indices.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [indices[i],indices[j]]=[indices[j],indices[i]];
  }
  order = indices; lastOrderVocabCount = vocab.length;
}

function updateLearnStats(){
  const el = document.getElementById('learnStats');
  let currentList = currentPracticeTopic === 'all' ? vocab : vocab.filter(v => v.topic === currentPracticeTopic);
  
  const total = currentList.length;
  const lvl0 = currentList.filter(v=>v.level===0).length;
  const lvl1 = currentList.filter(v=>v.level===1).length;
  const lvl2 = currentList.filter(v=>v.level===2).length;
  const lvl3 = currentList.filter(v=>v.level===3).length;
  el.textContent = `📊 Thống kê: Tổng ${total} từ · ⏳ Chưa học ${lvl0} · 🌱 Cấp 1: ${lvl1} · 🌿 Cấp 2: ${lvl2} · ✅ Đã thuộc: ${lvl3}`;
}

function refreshPractice(){
  const hint = document.getElementById('hintText');
  const input = document.getElementById('typeInput');
  const reveal = document.getElementById('meaningReveal');
  const progressText = document.getElementById('progressText');
  
  if(vocab.length===0){
    hint.textContent = "Chưa có từ vựng"; input.disabled = true; progressText.textContent = "Từ 0 / 0";
    reveal.textContent = "Hãy thêm từ ở tab Thêm từ"; updateLearnStats(); return;
  }
  
  if(order.length===0 || lastOrderVocabCount !== vocab.length){
    buildPracticeOrder(); currentIndex = 0; correctCount = 0;
  }
  
  if(order.length===0){
    input.disabled = true; hint.textContent = "Không có từ phù hợp"; progressText.textContent = "Từ 0 / 0";
    reveal.textContent = "Chủ đề / Chế độ này không có từ nào.";
    document.getElementById('exampleSentence').style.display='none';
    document.getElementById('nextBtn').style.display='none';
    updateLearnStats(); return;
  }
  
  input.disabled = false; loadCurrentWord();
}

