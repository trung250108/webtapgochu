  document.getElementById('scoreText').textContent = `Đúng: ${correctCount}`;
  
  updateLearnStats();
  mainSpeakClickCount = 0; speakWord(w.word, NORMAL_RATE); input.focus();
}

function checkTyped(){
  const input = document.getElementById('typeInput');
  const reveal = document.getElementById('meaningReveal');
  const w = vocab[order[currentIndex]];
  const typed = input.value;
  const target = w.word.trim();

  const chars = document.getElementById('hintText').querySelectorAll('span');
  let allCorrectSoFar = true;
  chars.forEach((span, i)=>{
    span.className='';
    if(i < typed.length){
      if(typed[i].toLowerCase() === target[i].toLowerCase()){ span.classList.add('typed-ok'); }
      else { span.classList.add('typed-bad'); allCorrectSoFar = false; }
    }
  });

  if(typed.trim().toLowerCase() === target.toLowerCase()){
    input.className='type-input correct'; input.readOnly=true;
    reveal.innerHTML = `✅ ${w.word} <span style="font-size:0.8em; color:var(--muted)">(${escapeHtml(w.topic)})</span> → ${w.meanings.join('; ')}`;
    reveal.className='meaning-reveal';
    document.getElementById('nextBtn').style.display='inline-block';
    
    correctCount++; document.getElementById('scoreText').textContent = `Đúng: ${correctCount}`;
    speakMeaning(w.meanings.join(', '));
    
    if(w.example){
      const exEl = document.getElementById('exampleSentence');
      exEl.innerHTML = '📝 ' + highlightWordInSentence(w.example, w.word);
      exEl.style.display = 'block';
    }
    
    if(w.level < MAX_LEVEL){ w.level++; saveVocab(); updateLearnStats(); }
  } else if(typed.length>0 && allCorrectSoFar){ input.className='type-input'; }
  else if(typed.length>0){ input.className='type-input wrong'; }
  else { input.className='type-input'; }
}

