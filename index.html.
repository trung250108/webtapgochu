const MAX_LEVEL = 3;
const LEVEL_LABELS = ['⏳ Chưa học', '🌱 Cấp 1', '🌿 Cấp 2', '✅ Cấp 3'];
const LEVEL_INCLUDE_CHANCE = [1, 0.6, 0.35, 0.15]; 
const STORAGE_KEY = 'luyenTuVungAnhViet.vocab.v2'; // Nâng version để reset nếu cần

function normalizeLevel(item){
  if(typeof item.level === 'number' && Number.isFinite(item.level)){
    return Math.max(0, Math.min(MAX_LEVEL, Math.round(item.level)));
  }
  return item.status === 'known' ? MAX_LEVEL : (item.status === 'learned' ? 1 : 0);
}

function saveVocab(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(vocab)); }
  catch(err){ console.warn('Không lưu được dữ liệu:', err); }
  renderTopicSelects(); 
}

function loadVocab(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw === null) return null; 
    const data = JSON.parse(raw);
    if(!Array.isArray(data)) return null;
    return data.map(item=>{
        if(!item || typeof item.word !== 'string' || !item.word.trim()) return null;
        let meanings = [];
        if(Array.isArray(item.meanings)) meanings = item.meanings.filter(m=>typeof m==='string' && m.trim()).map(m=>m.trim());
        else if(typeof item.meaning === 'string' && item.meaning.trim()) meanings = [item.meaning.trim()];
        
        return {
          word: item.word.trim(),
          meanings,
          level: normalizeLevel(item),
          example: (typeof item.example === 'string') ? item.example : '',
          topic: (typeof item.topic === 'string' && item.topic.trim()) ? item.topic.trim() : 'Chung' 
        };
      }).filter(Boolean);
  }catch(err){ return null; }
}

function splitMeanings(raw){
  if(!raw) return [];
  return String(raw).split(';').map(m => m.trim()).filter(Boolean);
}
// --- START: simple topic inference (heuristic by keywords) ---
const TOPIC_KEYWORDS = [
  { re: /\b(busi|finance|market|invest|budget|profit|commodity|enterprise|corporate|fund|margin|econom)\b/i, topic: 'Kinh Doanh' },
  { re: /\b(climate|environment|green|sustain|pollut|emission|ecosystem|conserve|recycle|migrate)\b/i, topic: 'Môi Trường' },
  { re: /\b(tech|software|device|system|data|digital|compute|network|monitor|deploy|engineer|automation|program)\b/i, topic: 'Công Nghệ' },
  { re: /\b(health|medical|disease|diagnose|injury|treatment|patient|clinic|hospital)\b/i, topic: 'Sức Khỏe' },
  { re: /\b(learn|study|lecture|student|research|academic|education|curriculum|assess|grade|exam)\b/i, topic: 'Học Tập' },
  { re: /\b(culture|art|literature|history|narrative|museum|festival|author)\b/i, topic: 'Văn Hoá' },
  { re: /\b(policy|law|legislation|legal|justice|court|regul)\b/i, topic: 'Luật' },
  { re: /\b(social|community|democ|public|inequality|diversity|welfare|societ)\b/i, topic: 'Xã Hội' },
  { re: /\b(personal|attitude|character|ambitious|friendly|lazy|introspective|charisma|emotion)\b/i, topic: 'Tính Cách' },
  { re: /\b(food|cook|grocery|nutrient|travel|wash|house|daily|dinner)\b/i, topic: 'Đời Sống' },
  { re: /\b(media|press|journal|article|broadcast|expose|comment|dialogue|truyen|truyền)\b/i, topic: 'Truyền Thông' }
];

function inferTopicFromText(text){
  if(!text) return 'Chung';
  for(const m of TOPIC_KEYWORDS){
    if(m.re.test(text)) return m.topic;
  }
  return 'Chung';
}
