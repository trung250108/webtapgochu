<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luyện Từ Vựng Anh - Việt (Theo Chủ Đề)</title>
<style>
  :root{
    --bg:#f4f6fb;
    --card:#ffffff;
    --primary:#4f6df5;
    --primary-dark:#3952c9;
    --text:#1f2537;
    --muted:#6b7280;
    --border:#e5e7eb;
    --green:#1fa971;
    --green-bg:#e7f8f0;
    --red:#e05260;
    --red-bg:#fdecee;
    --topic:#8b5cf6;
    --topic-bg:#ede9fe;
    --warning:#f59e0b;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background:var(--bg);
    color:var(--text);
    padding:24px 12px 60px;
  }
  .wrap{max-width:820px;margin:0 auto;}
  h1{
    text-align:center;
    font-size:1.6rem;
    margin-bottom:4px;
  }
  .subtitle{
    text-align:center;
    color:var(--muted);
    margin-bottom:24px;
    font-size:0.92rem;
  }
  
  /* Tabs */
  .tabs{
    display:flex;
    gap:8px;
    justify-content:center;
    margin-bottom:20px;
    flex-wrap: wrap;
  }
  .tab-btn{
    padding:10px 18px;
    border-radius:999px;
    border:1px solid var(--border);
    background:var(--card);
    cursor:pointer;
    font-size:0.92rem;
    font-weight:600;
    color:var(--muted);
    transition:.15s;
  }
  .tab-btn.active{
    background:var(--primary);
    color:#fff;
    border-color:var(--primary);
  }
  
  /* Cards & Panels */
  .card{
    background:var(--card);
    border-radius:16px;
    padding:22px;
    box-shadow:0 1px 3px rgba(0,0,0,.06);
    margin-bottom:18px;
  }
  .panel{display:none;}
  .panel.active{display:block;}

  /* Practice panel */
  .progress{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:14px;
    font-size:0.88rem;
    color:var(--muted);
  }
  .learn-stats{
    text-align:center;
    font-size:0.8rem;
    color:var(--muted);
    margin:-6px 0 16px;
  }
  
  /* Select and Mode Rows */
  .filter-row{
    display:flex;
    flex-direction: column;
    align-items:center;
    gap:10px;
    margin-bottom:16px;
  }
  .topic-select{
    padding:8px 16px;
    border-radius:10px;
    border:1.5px solid var(--border);
    font-size:0.9rem;
    font-weight:600;
    color:var(--text);
    outline:none;
    background:var(--card);
    cursor:pointer;
    width: 100%;
    max-width: 300px;
  }
  .topic-select:focus{border-color:var(--primary);}
  .mode-row{
    display:flex;
    justify-content:center;
    gap:8px;
    flex-wrap:wrap;
  }
  .mode-btn{
    padding:7px 14px;
    border-radius:999px;
    border:1px solid var(--border);
    background:#f4f6fb;
    cursor:pointer;
    font-size:0.8rem;
    font-weight:600;
    color:var(--muted);
    transition:.15s;
  }
  .mode-btn.active{
    background:var(--primary);
    color:#fff;
    border-color:var(--primary);
  }
  .mode-btn:hover:not(.active){background:#e1e5fb;}
  
  /* Word Box */
  .word-box{
    text-align:center;
    padding:20px 10px;
  }
  .hint-row{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    margin-bottom:18px;
  }
  .hint{
    font-size:2.2rem;
    font-weight:700;
    color:var(--text);
    margin-bottom:0;
    letter-spacing:1px;
  }
  .hint span{transition:.1s;}
  .hint span.typed-ok{color:var(--green);}
  .hint span.typed-bad{color:var(--red);text-decoration:underline wavy var(--red);}
  .speak-btn{
    background:#eef0fb;
    color:var(--primary-dark);
    border-radius:50%;
    width:44px;
    height:44px;
    font-size:1.2rem;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    padding:0;
    border: none;
    cursor: pointer;
  }
  .speak-btn:hover{background:#e1e5fb;}
  .speak-btn:active{transform:scale(0.94);}
  .speak-btn-sm{
    background:none;
    border:none;
    color:var(--primary);
    font-size:1rem;
    cursor:pointer;
    padding:2px 6px;
  }
  .speak-btn-sm:hover{color:var(--primary-dark);}
  
  .type-input{
    width:100%;
    max-width:320px;
    padding:12px 16px;
    font-size:1.1rem;
    border:2px solid var(--border);
    border-radius:12px;
    text-align:center;
    outline:none;
    transition:.15s;
  }
  .type-input:focus{border-color:var(--primary);}
  .type-input.correct{border-color:var(--green);background:var(--green-bg);}
  .type-input.wrong{border-color:var(--red);background:var(--red-bg);}
  .meaning-reveal{
    margin-top:18px;
    font-size:1.3rem;
    font-weight:700;
    color:var(--green);
    min-height:34px;
  }
  .meaning-reveal.empty{color:var(--border);}
  .example-sentence{
    margin-top:10px;
    font-size:0.92rem;
    color:var(--muted);
    font-style:italic;
    line-height:1.5;
    max-width:480px;
    margin-left:auto;
    margin-right:auto;
  }
  .example-sentence b{color:var(--primary-dark);font-style:normal;}
  
  /* Practice Actions */
  .practice-actions{
    display:flex;
    justify-content:center;
    gap:10px;
    margin-top:20px;
    flex-wrap: wrap;
  }
  button{
    cursor:pointer;
    border:none;
    border-radius:10px;
    padding:10px 16px;
    font-size:0.9rem;
    font-weight:600;
  }
  .btn-primary{background:var(--primary);color:#fff;}
  .btn-primary:hover{background:var(--primary-dark);}
  .btn-ghost{background:#eef0fb;color:var(--primary-dark);}
  .btn-ghost:hover{background:#e1e5fb;}
  .btn-danger{background:var(--red-bg);color:var(--red);}
  .btn-danger:hover{background:#f9d9dc;}
  .btn-warning{background:#fffbeb;color:var(--warning); border: 1px solid #fde68a;}
  .btn-warning:hover{background:#fef3c7;}

  /* Add word panel */
  label{
    display:block;
    font-size:0.85rem;
    font-weight:600;
    margin:14px 0 6px;
    color:var(--muted);
  }
  input[type=text], textarea{
    width:100%;
    padding:10px 12px;
    border:1.5px solid var(--border);
    border-radius:10px;
    font-size:0.95rem;
    outline:none;
    font-family:inherit;
  }
  input[type=text]:focus, textarea:focus{border-color:var(--primary);}
  textarea{resize:vertical;min-height:80px;}
  .row{display:flex;gap:10px;flex-wrap:wrap;}
  .row > div{flex:1;min-width:180px;}
  
  /* Status & Text */
  .section-title{
    font-weight:700;
    margin-bottom:4px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .section-desc{
    font-size:0.82rem;
    color:var(--muted);
    margin-bottom:10px;
  }
  .status-msg{
    font-size:0.85rem;
    margin-top:10px;
    padding:8px 10px;
    border-radius:8px;
    display:none;
  }
  .status-msg.show{display:block;}
  .status-ok{background:var(--green-bg);color:var(--green);}
  .status-err{background:var(--red-bg);color:var(--red);}
  .status-loading{background:#eef0fb;color:var(--primary-dark);}

  /* List panel */
  table{
    width:100%;
    border-collapse:collapse;
    font-size:0.9rem;
  }
  th, td{
    text-align:left;
    padding:12px 8px;
    border-bottom:1px solid var(--border);
    vertical-align: top;
  }
  th{color:var(--muted);font-weight:600;font-size:0.8rem;}
  td.word-col{font-weight:600;}
  
  .topic-badge {
    display: inline-block;
    background: var(--topic-bg);
    color: var(--topic);
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: 6px;
    margin-top: 4px;
    font-weight: 600;
    cursor: pointer;
  }
  .topic-badge:hover { opacity: 0.8; text-decoration: underline; }
  
  .meanings-list{display:flex;flex-wrap:wrap;gap:6px;}
  .meaning-chip{
    display:inline-flex;
    align-items:center;
    gap:3px;
    background:#eef0fb;
    border-radius:8px;
    padding:3px 4px 3px 8px;
    font-size:0.85rem;
    color:var(--text);
  }
  .meaning-chip .meaning-text{cursor:pointer;}
  .meaning-chip .meaning-text:hover{text-decoration:underline;}
  .meaning-chip button{
    background:none;
    border:none;
    padding:2px 4px;
    font-size:0.78rem;
    cursor:pointer;
    color:var(--muted);
    border-radius:6px;
  }
  .meaning-chip button:hover{background:#dfe2f5;color:var(--primary-dark);}
  .meaning-chip button.meaning-del-btn:hover{background:var(--red-bg);color:var(--red);}
  
  /* Editing inputs in table */
  .meaning-edit-input, .example-edit-input, .topic-edit-input{
    font-size:0.85rem;
    padding:3px 6px;
    border:1.5px solid var(--primary);
    border-radius:6px;
    outline:none;
  }
  .topic-edit-input { width: 100%; max-width: 100px; }
  .meaning-edit-input { width: 110px; }
  .example-edit-input { flex:1; min-width: 150px; }
  
  .example-row{
    margin-top:8px;
    font-size:0.8rem;
    color:var(--muted);
    font-style:italic;
    display:flex;
    align-items:flex-start;
    gap:4px;
    flex-wrap:wrap;
  }
  .example-row .example-text{cursor:pointer;}
  .example-row .example-text:hover{text-decoration:underline;}
  .example-row button{
    background:none;border:none;cursor:pointer;
    font-size:0.78rem;color:var(--muted);padding:1px 4px;border-radius:5px;font-style:normal;
  }
  .example-row button:hover{background:#eef0fb;color:var(--primary-dark);}
  .example-add-btn{color:var(--primary) !important;}
  
  .del-btn{
    background:none;
    border:none;
    color:var(--red);
    font-size:0.85rem;
    padding:4px 8px;
    cursor:pointer;
  }
  .del-btn:hover{text-decoration:underline;}
  
  /* Status Badges */
  .status-badge{
    display:inline-block;
    padding:3px 9px;
    border-radius:999px;
    font-size:0.78rem;
    font-weight:600;
    white-space:nowrap;
  }
  .status-badge.level-0{background:#eef0f2;color:var(--muted);}
  .status-badge.level-1{background:#fff7e6;color:#a8720b;}
  .status-badge.level-2{background:#eaf1fd;color:#2f6fd6;}
  .status-badge.level-3{background:var(--green-bg);color:var(--green);}
  
  .reset-status-btn{
    background:none;
    border:none;
    color:var(--muted);
    font-size:0.85rem;
    padding:2px 5px;
    cursor:pointer;
    margin-left:2px;
  }
  .reset-status-btn:hover{color:var(--primary-dark);}

  /* Search & Controls */
  .list-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:12px;
    flex-wrap:wrap;
    gap:8px;
  }
  .count-badge{
    background:#eef0fb;
    color:var(--primary-dark);
    padding:4px 10px;
    border-radius:999px;
    font-size:0.8rem;
    font-weight:600;
  }
  .search-row{
    display:flex;
    gap:8px;
    margin-bottom:14px;
  }
  .search-input{
    flex:1;
    padding:10px 14px;
    border:1.5px solid var(--border);
    border-radius:10px;
    font-size:0.9rem;
    outline:none;
    font-family:inherit;
  }
  .search-input:focus{border-color:var(--primary);}
  #clearSearchBtn{padding:8px 14px;}
  .empty-note{
    text-align:center;
    color:var(--muted);
    padding:20px;
    font-size:0.9rem;
  }
</style>
</head>
<body>
<div class="wrap">
  <h1>📚 Luyện Từ Vựng Anh - Việt</h1>
  <p class="subtitle">Học theo chủ đề & Tự động phân loại</p>

  <div class="tabs">
    <button class="tab-btn active" data-tab="practice">✍️ Luyện gõ</button>
    <button class="tab-btn" data-tab="add">➕ Thêm từ</button>
    <button class="tab-btn" data-tab="list">📋 Danh sách</button>
  </div>

  <!-- PRACTICE PANEL -->
  <div class="panel active" id="panel-practice">
    <div class="card">
      <div class="progress">
        <span id="progressText">Từ 0 / 0</span>
        <span id="scoreText">Đúng: 0</span>
      </div>
      <div class="learn-stats" id="learnStats"></div>
      
      <div class="filter-row">
        <select id="practiceTopicSelect" class="topic-select">
          <option value="all">Tất cả chủ đề</option>
          <!-- Options populated by JS -->
        </select>
        <div class="mode-row" id="modeRow">
          <button class="mode-btn active" data-mode="all">🔀 Tất cả từ</button>
          <button class="mode-btn" data-mode="review">✅ Ôn từ đã học</button>
          <button class="mode-btn" data-mode="new">🆕 Chỉ từ mới</button>
        </div>
      </div>

      <div class="word-box">
        <div class="hint-row">
          <div class="hint" id="hintText">word</div>
          <button class="speak-btn" id="speakBtn" title="Nghe phát âm" type="button">🔊</button>
        </div>
        <input type="text" id="typeInput" class="type-input" placeholder="Gõ theo từ ở trên..." autocomplete="off">
        <div class="meaning-reveal empty" id="meaningReveal">Nghĩa sẽ hiện ở đây</div>
        <div class="example-sentence" id="exampleSentence" style="display:none;"></div>
      </div>
      <div class="practice-actions">
        <button class="btn-ghost" id="skipBtn">Bỏ qua ⏭</button>
        <button class="btn-ghost" id="shuffleBtn">🔀 Trộn từ</button>
        <button class="btn-primary" id="nextBtn" style="display:none;">Từ tiếp theo →</button>
      </div>
    </div>
  </div>

  <!-- ADD PANEL -->
  <div class="panel" id="panel-add">
    <div class="card">
      <div class="section-title">✍️ Thêm thủ công</div>
      <div class="section-desc">Tự nhập từ, nghĩa và chủ đề. Nếu để trống chủ đề, hệ thống sẽ tự phân loại.</div>
      <div class="row">
        <div>
          <label>Từ tiếng Anh</label>
          <input type="text" id="manualWord" placeholder="ví dụ: apple">
        </div>
        <div>
          <label>Nghĩa tiếng Việt</label>
          <input type="text" id="manualMeaning" placeholder="ví dụ: quả táo ; đồ ăn">
        </div>
        <div>
          <label>Chủ đề (Để trống = Tự động)</label>
          <input type="text" id="manualTopic" placeholder="Tự động phân loại..." value="">
        </div>
      </div>
      <button class="btn-primary" id="manualAddBtn" style="margin-top:14px;">Thêm vào danh sách</button>
      <div class="status-msg" id="manualStatus"></div>
    </div>

    <div class="card">
      <div class="section-title">🌐 Thêm tự động (tra nghĩa online)</div>
      <div class="section-desc">Gõ danh sách từ, hệ thống sẽ tự tra nghĩa. Nếu để trống ô Chủ đề, AI sẽ tự đoán chủ đề cho từng từ.</div>
      <div style="margin-bottom:10px;">
        <label>Chủ đề chung (Để trống = AI tự đoán cho từng từ):</label>
        <input type="text" id="autoTopic" placeholder="Tự động phân loại..." value="" style="max-width: 300px;">
      </div>
      <textarea id="autoWords" placeholder="ví dụ:&#10;beautiful&#10;journey&#10;software"></textarea>
      <button class="btn-primary" id="autoAddBtn" style="margin-top:12px;">🔍 Tự động tra nghĩa &amp; thêm</button>
      <div class="status-msg" id="autoStatus"></div>
    </div>
  </div>

  <!-- LIST PANEL -->
  <div class="panel" id="panel-list">
    <div class="card">
      <div class="list-top">
        <span class="count-badge" id="countBadge">0 từ</span>
        <select id="listTopicSelect" class="topic-select" style="width:auto; max-width:200px; padding: 4px 10px;">
           <option value="all">Tất cả chủ đề</option>
        </select>
        <div style="display:flex; gap: 8px;">
            <button class="btn-warning" id="autoSortAllBtn" title="Phân loại các từ chưa có chủ đề (Chung)">🪄 Tự phân loại</button>
            <button class="btn-danger" id="clearAllBtn">🗑 Xóa tất cả</button>
        </div>
      </div>
      <div class="search-row">
        <input type="text" id="searchInput" class="search-input" placeholder="🔍 Tìm từ tiếng Anh hoặc nghĩa...">
        <button class="btn-ghost" id="clearSearchBtn" style="display:none;">✕</button>
      </div>
      <div id="listContainer" style="overflow-x: auto;"></div>
    </div>

    <div class="card">
      <div class="section-title">💾 Lưu &amp; khôi phục danh sách</div>
      <div class="practice-actions" style="margin-top:12px; justify-content: flex-start;">
        <button class="btn-primary" id="exportBtn">⬇️ Tải file danh sách (.json)</button>
        <button class="btn-ghost" id="importTriggerBtn">⬆️ Nhập từ file</button>
        <input type="file" id="importFileInput" accept="application/json,.json" style="display:none;">
      </div>
      <div class="status-msg" id="importStatus"></div>
    </div>
  </div>
</div>

<script>
// ---------- TỪ ĐIỂN PHÂN LOẠI CHỦ ĐỀ TỰ ĐỘNG ----------
// Hệ thống sẽ quyét các từ khóa tiếng Anh và Việt này để quyết định chủ đề
const TOPIC_KEYWORDS = {
  "Kinh Doanh & Tài Chính": ["business", "company", "finance", "money", "sell", "buy", "kinh doanh", "công ty", "tiền", "bán", "mua", "tài chính", "đầu tư", "accumulate", "allocate", "optimize", "prioritize", "acquisition", "market", "thị trường", "doanh nghiệp"],
  "Môi Trường & Tự Nhiên": ["environment", "climate", "pollution", "green", "nature", "môi trường", "khí hậu", "ô nhiễm", "cây", "rác", "animal", "động vật", "sustainable", "bền vững", "weather", "thời tiết"],
  "Công Nghệ & IT": ["technology", "computer", "software", "internet", "công nghệ", "máy tính", "phần mềm", "mạng", "app", "digital", "data", "dữ liệu", "code", "lập trình"],
  "Sức Khỏe & Y Tế": ["health", "medicine", "doctor", "hospital", "sức khỏe", "bác sĩ", "bệnh", "thuốc", "y tế", "nutrient", "dinh dưỡng", "medical", "khỏe", "đau"],
  "Đời Sống Hàng Ngày": ["cook", "wash", "travel", "nhà", "nấu ăn", "giặt", "cuộc sống", "ăn", "uống", "ngủ", "home", "family", "gia đình", "food", "thức ăn"],
  "Học Tập & Giáo Dục": ["study", "learn", "school", "student", "teacher", "học", "trường", "giáo viên", "sinh viên", "procrastination", "articulate", "education", "giáo dục", "knowledge", "kiến thức"],
  "Tính Cách": ["charismatic", "lazy", "friendly", "introspective", "tính cách", "thân thiện", "lười", "tốt bụng", "personality", "thông minh", "smart", "clever", "kind"],
  "Cảm Xúc": ["nervous", "happy", "sad", "angry", "cảm xúc", "vui", "buồn", "giận", "lo lắng", "sợ", "feeling", "emotion"]
};

// Hàm tự động đoán chủ đề
function guessTopic(word, meaning) {
    const textToAnalyze = (word + " " + meaning).toLowerCase();
    for (const [topic, keywords] of Object.entries(TOPIC_KEYWORDS)) {
        if (keywords.some(kw => textToAnalyze.includes(kw.toLowerCase()))) {
            return topic;
        }
    }
    return "Chung"; // Mặc định nếu không đoán được
}

const EXAMPLE_SENTENCES = {
  "accumulate": "Dust had accumulated on the shelves for years.",
  "allocate": "The government will allocate more funds to healthcare.",
  "controversial": "The new policy has proven to be highly controversial.",
  "drastic": "The government took drastic measures to control inflation.",
  "eloquent": "The lawyer gave an eloquent closing statement.",
  "implement": "The school plans to implement a new grading system.",
  "optimize": "We redesigned the website to optimize loading speed.",
  "prioritize": "You need to prioritize your tasks when you're this busy.",
  "sustainable practice": "Companies are adopting sustainable practices to protect the environment."
};

// Dữ liệu gốc đã được mở rộng để phù hợp với bộ từ khóa
const DEFAULT_VOCAB = [
  {word:"accumulate", meaning:"tích lũy", topic:"Kinh Doanh & Tài Chính"}, 
  {word:"acquisition", meaning:"mua lại công ty", topic:"Kinh Doanh & Tài Chính"}, 
  {word:"allocate", meaning:"phân bổ", topic:"Kinh Doanh & Tài Chính"}, 
  {word:"time management", meaning:"quản lý thời gian", topic:"Kinh Doanh & Tài Chính"}, 
