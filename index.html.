function showStatus(el, msg, type){
  el.textContent = msg; el.className = 'status-msg show status-' + type;
}

function addWord(word, meaning, topicInput){
  const newMeanings = splitMeanings(meaning);
  if(newMeanings.length===0) return;
  
  // Áp dụng thuật toán đoán nếu topic trống hoặc bằng "Chung"
  let finalTopic = topicInput && topicInput.trim() !== "" ? topicInput.trim() : guessTopic(word, meaning);

  const exists = vocab.find(v=>v.word.toLowerCase()===word.toLowerCase());
  
  if(exists){
    newMeanings.forEach(m=>{
      if(!exists.meanings.some(em=>em.toLowerCase()===m.toLowerCase())) exists.meanings.push(m);
    });
    // Ghi đè chủ đề nếu cũ là Chung và mới khác Chung
    if(exists.topic === "Chung" && finalTopic !== "Chung") exists.topic = finalTopic;
  } else {
    vocab.push({word, meanings:newMeanings, level:0, example: EXAMPLE_SENTENCES[word] || '', topic: finalTopic});
  }
  sortVocab(); order = []; saveVocab();
}

