  const existingWords = new Set(vocab.map(v=>v.word.toLowerCase()));
  let changed = false;
  DEFAULT_VOCAB.forEach(dv=>{
    if(!existingWords.has(dv.word.toLowerCase())){
      vocab.push({word: dv.word, meanings: splitMeanings(dv.meaning), level: 0, example: EXAMPLE_SENTENCES[dv.word] || '', topic: dv.topic || 'Chung'});
      existingWords.add(dv.word.toLowerCase());
      changed = true;
    }
  });
  if(changed) saveVocab();
}
