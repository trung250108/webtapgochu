document.getElementById('autoAddBtn').addEventListener('click', async ()=>{
  const area = document.getElementById('autoWords');
  const status = document.getElementById('autoStatus');
  const topic = document.getElementById('autoTopic').value.trim();
  const raw = area.value.trim();
  
  if(!raw){ showStatus(status, '⚠️ Hãy nhập ít nhất một từ.', 'err'); return; }
  const words = [...new Set(raw.split(/[\n,]/).map(w=>w.trim()).filter(Boolean))];

  let added = 0, failed = [];
  for(let i=0; i<words.length; i++){
    showStatus(status, `⏳ Đang tra (${i+1}/${words.length}): "${words[i]}"...`, 'loading');
    try{
      const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(words[i])}&langpair=en|vi`);
      const data = await res.json();
      if(data && data.responseData && data.responseData.translatedText){
        addWord(words[i], data.responseData.translatedText, topic);
        added++;
      } else throw new Error();
    }catch(err){ failed.push(words[i]); }
    await new Promise(r=>setTimeout(r, 350));
  }
  if(failed.length===0){ showStatus(status, `✅ Đã thêm ${added} từ (Chủ đề được tự phân loại)!`, 'ok'); area.value=''; }
  else { showStatus(status, `✅ Thêm ${added} từ. ⚠️ Không tra được: ${failed.join(', ')}`, 'err'); }
});

