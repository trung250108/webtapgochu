      </td>
      <td><button class="speak-btn-sm" data-word="${escapeHtml(v.word)}">🔊</button></td>
      <td><span class="add-meaning-cell" data-idx="${idx}"><button class="speak-btn-sm add-meaning-btn" data-idx="${idx}">➕ nghĩa</button></span></td>
      <td><button class="del-btn" data-idx="${idx}">Xóa</button></td>
    </tr>`;
  });
  html += '</tbody></table>';
  container.innerHTML = html;
  attachListEvents(container);
}

function attachListEvents(container) {
  container.querySelectorAll('.topic-badge').forEach(badge => {
    badge.addEventListener('click', () => {
      const idx = parseInt(badge.dataset.idx);
      const currentTopic = vocab[idx].topic;
      badge.innerHTML = `<input type="text" class="topic-edit-input" value="${escapeHtml(currentTopic)}">`;
      const input = badge.querySelector('input');
      
      const saveTopic = () => {
         const newVal = input.value.trim() || 'Chung';
         vocab[idx].topic = newVal;
         saveVocab(); renderList(); renderTopicSelects();
      };
      input.addEventListener('blur', saveTopic);
      input.addEventListener('keydown', (e) => { if(e.key === 'Enter') saveTopic(); if(e.key === 'Escape') renderList(); });
      input.focus(); input.select();
    });
  });

  container.querySelectorAll('.reset-status-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{ vocab[parseInt(btn.dataset.idx)].level = 0; order = []; saveVocab(); renderList(); });
  });

  container.querySelectorAll('.meaning-text').forEach(textSpan=>{
    textSpan.addEventListener('click', (e)=>{
      const chip = e.target.closest('.meaning-chip');
      const idx = parseInt(chip.dataset.idx); const mIdx = parseInt(chip.dataset.midx);
      chip.innerHTML = `<input type="text" class="meaning-edit-input" value="${escapeHtml(vocab[idx].meanings[mIdx])}">`;
      const input = chip.querySelector('input');
      const save = () => { if(input.value.trim()) vocab[idx].meanings[mIdx] = input.value.trim(); saveVocab(); renderList(); };
      input.addEventListener('blur', save);
      input.addEventListener('keydown', (e)=>{ if(e.key==='Enter') save(); if(e.key==='Escape') renderList(); });
      input.focus();
    });
  });
  
  container.querySelectorAll('.meaning-del-btn').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
       const chip = e.target.closest('.meaning-chip');
       vocab[parseInt(chip.dataset.idx)].meanings.splice(parseInt(chip.dataset.midx), 1);
       saveVocab(); renderList();
    });
  });

  container.querySelectorAll('.add-meaning-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const cell = e.target.closest('.add-meaning-cell'); const idx = parseInt(cell.dataset.idx);
      cell.innerHTML = `<input type="text" class="meaning-edit-input" placeholder="Nghĩa mới...">`;
      const input = cell.querySelector('input');
      const save = () => { if(input.value.trim()) addWord(vocab[idx].word, input.value.trim(), vocab[idx].topic); renderList(); }
      input.addEventListener('blur', save);
      input.addEventListener('keydown', (e)=>{ if(e.key==='Enter') save(); if(e.key==='Escape') renderList(); });
      input.focus();
    });
  });

  container.querySelectorAll('.example-text, .example-add-btn').forEach(el=>{
    el.addEventListener('click', (e)=>{
      const row = e.target.closest('.example-row'); const idx = parseInt(row.dataset.idx);
      row.innerHTML = `<input type="text" class="example-edit-input" value="${escapeHtml(vocab[idx].example || '')}">`;
      const input = row.querySelector('input');
      const save = () => { vocab[idx].example = input.value.trim(); saveVocab(); renderList(); };
      input.addEventListener('blur', save);
      input.addEventListener('keydown', (ev)=>{ if(ev.key==='Enter') save(); if(ev.key==='Escape') renderList(); });
      input.focus();
    });
  });
  
  container.querySelectorAll('.example-del-btn').forEach(btn=>{
    btn.addEventListener('click', (e)=>{ vocab[parseInt(e.target.closest('.example-row').dataset.idx)].example = ''; saveVocab(); renderList(); });
  });

  container.querySelectorAll('.speak-btn-sm').forEach(btn=>{
    if(btn.classList.contains('add-meaning-btn')) return;
    btn.addEventListener('click', ()=>speakWord(btn.dataset.word, NORMAL_RATE));
  });
  
  container.querySelectorAll('.del-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      vocab.splice(parseInt(btn.dataset.idx),1);
      order = []; saveVocab(); renderList(); renderTopicSelects();
    });
  });
}

function escapeHtml(str){
  const div = document.createElement('div'); div.textContent = str; return div.innerHTML;
}
function highlightWordInSentence(sentence, word){
  const re = new RegExp('(' + escapeHtml(word).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
  return escapeHtml(sentence).replace(re, '<b>$1</b>');
}

document.getElementById('searchInput').addEventListener('input', renderList);
document.getElementById('clearSearchBtn').addEventListener('click', ()=>{
  document.getElementById('searchInput').value = ''; renderList(); document.getElementById('searchInput').focus();
});

let clearAllArmed = false;
document.getElementById('clearAllBtn').addEventListener('click', (e)=>{
  if(vocab.length===0) return;
  if(!clearAllArmed){
    clearAllArmed = true; e.target.textContent = '⚠️ Bấm lần nữa để xóa tất cả';
    setTimeout(()=>{ clearAllArmed = false; e.target.textContent = '🗑 Xóa tất cả'; }, 3000);
  } else {
    vocab = []; order = []; saveVocab(); renderList(); renderTopicSelects();
    clearAllArmed = false; e.target.textContent = '🗑 Xóa tất cả';
  }
});

document.getElementById('exportBtn').addEventListener('click', ()=>{
  if(vocab.length===0) return alert('Danh sách trống.');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([JSON.stringify(vocab, null, 2)], {type:'application/json'}));
  a.download = `tu-vung-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
});

document.getElementById('importTriggerBtn').addEventListener('click', ()=>document.getElementById('importFileInput').click());
document.getElementById('importFileInput').addEventListener('change', (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = (evt)=>{
    try{
      const data = JSON.parse(evt.target.result);
      data.forEach(item=>{
        if(!item || typeof item.word !== 'string' || !item.word.trim()) return;
        const w = item.word.trim();
        const m = (Array.isArray(item.meanings) ? item.meanings : [item.meaning]).filter(x=>x).join('; ');
        
        let t = item.topic;
        if(!t || t.trim()==="" || t === "Chung") t = guessTopic(w, m);

        if(m) addWord(w, m, t);
        
        const exists = vocab.find(v=>v.word.toLowerCase()===w.toLowerCase());
        if(exists){
            exists.level = Math.max(exists.level, normalizeLevel(item));
            if(!exists.example && item.example) exists.example = item.example;
        }
      });
      saveVocab(); renderList(); renderTopicSelects();
      document.getElementById('importStatus').className='status-msg show status-ok';
      document.getElementById('importStatus').textContent='✅ Nhập file & Tự động phân loại thành công!';
    }catch(err){ alert('File không hợp lệ!'); }
  };
  reader.readAsText(file); e.target.value = '';
});

// Chạy khởi tạo UI
document.querySelectorAll('.mode-btn').forEach(b=>b.classList.toggle('active', b.dataset.mode===practiceMode));
tryLoadExternalVocab().then(()=>{ renderTopicSelects(); refreshPractice(); });
</script>
